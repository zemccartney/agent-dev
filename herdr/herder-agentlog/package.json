{
  "name": "herder-agentlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#agentlog/*": {
      "types": "./src/*.ts",
      "default": "./.build/test/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm build && node --test --test-reporter=tap test/*.test.ts",
    "test:integration": "pnpm build && node --test --test-reporter=tap --test-concurrency=1 test/integration/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@xterm/headless": "5.5.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=25.7.0"
  },
  "packageManager": "pnpm@11.26.0"
}
