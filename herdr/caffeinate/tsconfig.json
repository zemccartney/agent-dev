{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/main.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.cjs",
    "test/**/*.ts",
    "test/**/*.mjs",
    "tsdown*.config.ts"
  ],
  "exclude": ["dist", ".build", "node_modules"]
}
