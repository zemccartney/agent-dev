{
  "name": "herdr-caffeinate",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#caffeinate/*": {
      "types": "./src/*.ts",
      "default": "./.build/test/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/preflight.cjs build && tsdown && node scripts/prepare-runtime.ts",
    "build:spike": "node scripts/preflight.cjs build && tsdown --config tsdown.spike.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "test": "pnpm build && node --test --test-reporter=tap test/*.test.ts",
    "test:herdr": "pnpm build && node --test --test-reporter=tap test/integration/herdr.test.ts",
    "test:runtime": "node --test --test-reporter=tap test/runtime-compatibility.test.mjs",
    "test:integration": "pnpm build && node --test --test-reporter=tap test/end-to-end.test.ts test/runtime.test.ts test/build.test.ts",
    "probe:herdr": "pnpm build && node scripts/probe-herdr.ts",
    "probe:tui": "pnpm build:spike && node scripts/probe-tui.ts",
    "probe:assertions": "pnpm build && node scripts/probe-assertions.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.26.0"
}
